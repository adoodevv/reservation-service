# Postgres connection used by the service, tests and the load harness.
DATABASE_URL=postgres://reservations:reservations@localhost:5433/reservations

# HTTP server
PORT=3000
HOST=0.0.0.0

# Connection pool. The load harness saturates this on purpose.
PG_POOL_MAX=32

# Default hold lifetime (seconds) before an abandoned checkout releases inventory.
HOLD_TTL_SECONDS=120

# Background reaper cadence (ms). Set to 0 to disable the in-process reaper.
REAPER_INTERVAL_MS=5000

# Allocation strategy: optimistic | serializable | pessimistic | naive
# `naive` is intentionally broken and exists only to prove the load test detects double-bookings.
ALLOCATION_STRATEGY=optimistic

# Max retries when an allocation attempt loses a race.
ALLOCATION_MAX_RETRIES=8
